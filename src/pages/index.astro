---
import Calculator from '../components/Calculator.astro';
import Layout from '../layouts/Layout.astro';
import { loadSnapshot } from '../lib/load-snapshot.ts';

export const prerender = false;

const { snapshot, cacheSeconds, stale } = await loadSnapshot();
// Vercel ISR honours this header: live data stays cached until the next Grand Prix is scored,
// the committed fallback only for a few minutes so the next visit retries OpenF1.
Astro.response.headers.set('Cache-Control', `public, s-maxage=${cacheSeconds}`);
---

<Layout>
	<Calculator snapshot={snapshot} stale={stale} />
</Layout>
