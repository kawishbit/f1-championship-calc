---
import snapshot from "../data/snapshot.json";

const updated = new Date(snapshot.generatedAt).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<div class="app" data-snapshot={JSON.stringify(snapshot)}>
  <header class="topbar">
    <div class="brand">
      <span class="speedmark" aria-hidden="true"><i></i><i></i><i></i></span>
      <div>
        <h1>Championship Calculator</h1>
        <p class="season">{snapshot.season} FIA Formula One World Championship&trade; fan calculator (unofficial)</p>
      </div>
    </div>
    <div class="view-toggle" role="tablist" aria-label="Standings view">
      <button type="button" data-view="drivers" role="tab" aria-selected="true">Drivers</button>
      <button type="button" data-view="teams" role="tab" aria-selected="false">Constructors</button>
    </div>
  </header>

  <main>
    <section class="standings-panel" aria-label="Standings">
      <div class="panel-head">
        <h2 id="standings-title">Driver standings</h2>
        <span class="updated">Updated {updated}</span>
      </div>
      <ol id="standings" class="standings"></ol>
    </section>

    <section class="scenario-panel" aria-label="Scenario builder">
      <div class="solver">
        <div class="panel-head">
          <h2>What would it take</h2>
        </div>
        <p class="hint">Shortest path for your contender if rivals scored nothing more — a best case, not a projection. For head-to-head finishes, use the scenario below.</p>
        <div class="ask-row">
          <div class="ask-field">
            <label for="contender">Contender</label>
            <select id="contender"></select>
          </div>
          <div class="ask-field">
            <label for="target">Target</label>
            <select id="target"></select>
          </div>
        </div>
        <div id="answer" class="answer" aria-live="polite"></div>
      </div>
      <div class="builder">
        <div class="panel-head">
          <h2>Scenario</h2>
          <span id="pick-total" class="pick-total"></span>
        </div>
        <p class="hint">Set a finish for every remaining round at once — e.g. Russell P1 everywhere — then repeat for a rival or fine-tune below.</p>
        <div class="bulk-row">
          <div class="ask-field">
            <label for="bulk-driver">Driver</label>
            <select id="bulk-driver"></select>
          </div>
          <div class="ask-field">
            <label for="bulk-pos">Finish</label>
            <select id="bulk-pos"></select>
          </div>
          <button type="button" id="bulk-apply" class="apply">Set all</button>
        </div>
        <p class="hint small">Sprints take the same finish when inside the top 8. The projected standings update live.</p>
        <details class="tune">
          <summary>Fine-tune each round (optional)</summary>
          <div id="rounds" class="rounds"></div>
        </details>
        <button type="button" id="reset" class="reset">Reset scenario</button>
      </div>
    </section>
  </main>

  <footer>
    <p>Unofficial fan project. Data: f1api.dev + OpenF1. Photos: F1 CDN via OpenF1.</p>
  </footer>
</div>

<script>
  import { projectStandings, leastEffortPath, RACE_POINTS, SPRINT_POINTS } from "../lib/championship.ts";

  const root = document.querySelector(".app");
  const data = JSON.parse(root.dataset.snapshot);

  const standingsEl = document.getElementById("standings");
  const standingsTitle = document.getElementById("standings-title");
  const contenderEl = document.getElementById("contender");
  const targetEl = document.getElementById("target");
  const answerEl = document.getElementById("answer");
  const roundsEl = document.getElementById("rounds");
  const resetBtn = document.getElementById("reset");
  const pickTotalEl = document.getElementById("pick-total");
  const bulkDriverEl = document.getElementById("bulk-driver");
  const bulkPosEl = document.getElementById("bulk-pos");
  const bulkApplyBtn = document.getElementById("bulk-apply");
  const viewButtons = [...document.querySelectorAll("[data-view]")];

  let view = "drivers";
  const scenario = {};
  const remaining = data.rounds.filter((r) => !r.played);
  const resetScenario = () => {
    for (const r of remaining) scenario[r.raceId] = { race: [], sprint: [] };
  };
  resetScenario();

  const entries = () =>
    view === "drivers"
      ? data.drivers.map((d) => ({
          id: d.driverId, label: d.name, sub: d.teamName,
          colour: d.colour, photo: d.photo, code: d.code,
          points: d.points, wins: d.wins,
        }))
      : data.teams.map((t) => ({
          id: t.teamId, label: t.name, sub: null,
          colour: t.colour, photo: null, code: null,
          points: t.points, wins: t.wins,
        }));

  function resultOptions(count, selected) {
    let html = `<option value="">—</option>`;
    for (let i = 1; i <= count; i++) html += `<option value="${i}"${selected === i ? " selected" : ""}>P${i}</option>`;
    return html;
  }

  function renderPeople(select, list, keep) {
    select.innerHTML = list
      .map((e) => `<option value="${e.id}"${e.id === keep ? " selected" : ""}>${e.label}</option>`)
      .join("");
    if (![...select.options].some((o) => o.value === keep)) select.selectedIndex = 0;
  }

  function renderContenders(list) {
    // Default to the standings leader (list is stored in rank order); keep the
    // visitor's choice afterwards.
    renderPeople(contenderEl, list, contenderEl.value || list[0]?.id);
  }

  function renderTargets(list) {
    const keep = Number(targetEl.value) || 1;
    targetEl.innerHTML = list
      .map((_, i) => `<option value="${i + 1}"${i + 1 === keep ? " selected" : ""}>P${i + 1}</option>`)
      .join("");
  }

  function renderBulk(list) {
    renderPeople(bulkDriverEl, list, bulkDriverEl.value || contenderEl.value || list[0]?.id);
    const keepPos = Number(bulkPosEl.value) || 1;
    let html = "";
    for (let i = 1; i <= list.length; i++) html += `<option value="${i}"${i === keepPos ? " selected" : ""}>P${i}</option>`;
    bulkPosEl.innerHTML = html;
  }

  function setPick(picks, key, id, pos) {
    const slots = picks[key];
    for (let i = 0; i < slots.length; i++) if (slots[i] === id) slots[i] = null;
    if (pos > 0) {
      while (slots.length < pos) slots.push(null);
      slots[pos - 1] = id;
    }
  }

  function syncRound(details, picks, key) {
    for (const sel of details.querySelectorAll(`select[data-key="${key}"]`)) {
      sel.value = String(picks[key].indexOf(sel.dataset.id) + 1 || "");
    }
  }

  function bindSelect(sel, picks, key, details) {
    sel.addEventListener("change", () => {
      setPick(picks, key, sel.dataset.id, Number(sel.value));
      syncRound(details, picks, key);
      renderStandings();
      refreshCounts();
    });
  }

  function buildRounds(list) {
    roundsEl.innerHTML = "";
    remaining.forEach((r, i) => {
      const picks = scenario[r.raceId];
      const details = document.createElement("details");
      details.className = "round";
      details.dataset.race = r.raceId;
      if (i === 0) details.open = true;
      details.innerHTML = `
        <summary>
          <span class="round-title">${r.name}</span>
          <span class="round-meta">R${r.round}${r.sprint ? " · Sprint" : ""}</span>
          <span class="count" data-empty="true">No picks</span>
        </summary>
        <div class="picks"></div>`;
      const picksEl = details.querySelector(".picks");
      for (const e of list) {
        const row = document.createElement("label");
        row.className = "pick";
        row.innerHTML = `<span class="pick-name"><i style="--c:${e.colour ?? "#666"}"></i>${e.label}</span>`;
        const sel = document.createElement("select");
        sel.dataset.id = e.id;
        sel.dataset.key = "race";
        sel.innerHTML = resultOptions(list.length, picks.race.indexOf(e.id) + 1 || "");
        sel.setAttribute("aria-label", `${e.label} finishing position, ${r.name}`);
        bindSelect(sel, picks, "race", details);
        row.append(sel);
        picksEl.append(row);
        if (r.sprint) {
          const srow = document.createElement("label");
          srow.className = "pick sprint";
          srow.innerHTML = `<span class="pick-name"><em>Sprint</em>${e.label}</span>`;
          const ssel = document.createElement("select");
          ssel.dataset.id = e.id;
          ssel.dataset.key = "sprint";
          ssel.innerHTML = resultOptions(8, picks.sprint.indexOf(e.id) + 1 || "");
          ssel.setAttribute("aria-label", `${e.label} sprint position, ${r.name}`);
          bindSelect(ssel, picks, "sprint", details);
          srow.append(ssel);
          picksEl.append(srow);
        }
      }
      roundsEl.append(details);
    });
    refreshCounts();
  }

  function pickCount(picks) {
    return picks.race.filter(Boolean).length + picks.sprint.filter(Boolean).length;
  }

  function refreshCounts() {
    let total = 0;
    for (const details of roundsEl.querySelectorAll("details.round")) {
      const picks = scenario[details.dataset.race];
      const n = pickCount(picks);
      total += n;
      const badge = details.querySelector(".count");
      badge.textContent = n === 0 ? "No picks" : `${n} pick${n === 1 ? "" : "s"}`;
      badge.dataset.empty = String(n === 0);
    }
    pickTotalEl.textContent = total === 0 ? "" : `${total} pick${total === 1 ? "" : "s"}`;
  }

  function renderStandings() {
    const list = entries();
    const base = list.map(({ id, points, wins }) => ({ id, points, wins }));
    const projected = projectStandings(base, scenario);
    const leaderPts = projected[0]?.points ?? 0;

    standingsTitle.textContent = view === "drivers" ? "Driver standings" : "Constructor standings";
    standingsEl.innerHTML = "";
    for (const s of projected) {
      const e = list.find((x) => x.id === s.id);
      const pos = projected.indexOf(s) + 1;
      const isMe = e.id === contenderEl.value;
      const li = document.createElement("li");
      li.className = "row";
      if (isMe) li.dataset.contender = "true";
      li.innerHTML = `
        <span class="pos" style="--c:${e.colour ?? "#666"}">${pos}</span>
        ${e.photo ? `<img class="photo" src="${e.photo}" alt="" loading="lazy" />` : `<span class="photo fallback" style="--c:${e.colour ?? "#666"}" aria-hidden="true">${(e.code ?? e.label).slice(0, 3)}</span>`}
        <span class="who"><strong>${e.label}</strong>${e.sub ? `<small>${e.sub}</small>` : ""}</span>
        <span class="pts"><strong>${s.points}</strong><small>${pos === 1 ? "Leader" : `+${leaderPts - s.points}`} · ${s.wins} win${s.wins === 1 ? "" : "s"}</small></span>`;
      standingsEl.append(li);
    }
  }

  function statRow(cells, slim = false) {
    return `<div class="stat-row${slim ? " slim" : ""}">${cells.map(([v, k]) => `<div class="stat"><b>${v}</b><span>${k}</span></div>`).join("")}</div>`;
  }

  function bar(havePct, needPct, label) {
    return `<div class="bar" role="img" aria-label="${label}"><i class="have" style="width:${havePct}%"></i>${needPct > 0 ? `<i class="need" style="width:${needPct}%"></i>` : ""}</div>`;
  }

  function renderSolver() {
    const list = entries();
    const me = list.find((x) => x.id === contenderEl.value) ?? list[0];
    const target = Number(targetEl.value) || 1;
    const base = list.map(({ id, points, wins }) => ({ id, points, wins }));
    const rounds = remaining.map((r) => ({ raceId: r.raceId, sprint: !!r.sprint }));
    const result = leastEffortPath(base, me.id, target, rounds);
    const final = me.points + result.pointsNeeded;
    const totalAvail = rounds.reduce((sum, r) => sum + RACE_POINTS[0] + (r.sprint ? SPRINT_POINTS[0] : 0), 0);
    const ceiling = Math.max(me.points + totalAvail, final, 1);
    const havePct = Math.min(100, (me.points / ceiling) * 100);
    const needPct = Math.min(100 - havePct, (result.pointsNeeded / ceiling) * 100);
    if (!result.possible) {
      answerEl.dataset.state = "impossible";
      answerEl.innerHTML = `
        ${statRow([[`P${result.position}`, "Best reachable"], [final, "Max pts"], [`P${target}`, "Target"]])}
        ${bar(havePct, needPct, `${me.label} maxes out at ${final} points`)}
        <p class="bar-cap">${me.label} cannot reach P${target} even winning everything. Use the scenario below for head-to-head finishes.</p>`;
    } else if (result.pointsNeeded === 0) {
      answerEl.dataset.state = "holds";
      answerEl.innerHTML = `
        ${statRow([[`P${target}`, "Held"], [me.points, "Points"], ["+0", "Needed"]])}
        ${bar(havePct, 0, `${me.label} already holds P${target}`)}
        <p class="bar-cap">${me.label} already holds P${target} — nothing more needed.</p>`;
    } else {
      const gpAvail = remaining.length * RACE_POINTS[0];
      const sprintAvail = remaining.filter((r) => r.sprint).length * SPRINT_POINTS[0];
      answerEl.dataset.state = "path";
      answerEl.innerHTML = `
        ${statRow([[`+${result.pointsNeeded}`, "Needed"], [final, "Finishes on"], [`P${target}`, "Target"]])}
        ${bar(havePct, needPct, `${me.label} needs ${result.pointsNeeded} more points`)}
        ${statRow([[gpAvail, "Grand Prix pts available"], [sprintAvail, "Sprint pts available"]], true)}
        <p class="bar-cap">${result.winsAdded > 0 ? `Includes ${result.winsAdded} win${result.winsAdded === 1 ? "" : "s"}. ` : ""}Best case — rivals score nothing more.</p>`;
    }
  }

  function render() {
    const list = entries();
    renderContenders(list);
    renderTargets(list);
    renderBulk(list);
    renderStandings();
    renderSolver();
  }

  contenderEl.addEventListener("change", render);
  targetEl.addEventListener("change", renderSolver);
  bulkApplyBtn.addEventListener("click", () => {
    const id = bulkDriverEl.value;
    const pos = Number(bulkPosEl.value) || 1;
    for (const r of remaining) {
      setPick(scenario[r.raceId], "race", id, pos);
      if (r.sprint && pos <= 8) setPick(scenario[r.raceId], "sprint", id, pos);
    }
    buildRounds(entries());
    renderStandings();
    refreshCounts();
  });
  resetBtn.addEventListener("click", () => {
    resetScenario();
    buildRounds(entries());
    render();
  });
  for (const b of viewButtons) {
    b.addEventListener("click", () => {
      view = b.dataset.view;
      for (const x of viewButtons) x.setAttribute("aria-selected", String(x === b));
      resetScenario();
      buildRounds(entries());
      render();
    });
  }

  buildRounds(entries());
  render();
</script>

<style is:global>
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-400.woff2") format("woff2");
    font-weight: 400; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-600.woff2") format("woff2");
    font-weight: 600; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-700.woff2") format("woff2");
    font-weight: 700; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-600italic.woff2") format("woff2");
    font-weight: 600; font-style: italic; font-display: swap;
  }
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-700italic.woff2") format("woff2");
    font-weight: 700; font-style: italic; font-display: swap;
  }

  .app {
    --bg: #08080d;
    --surface: #0e0e15;
    --line: rgba(255, 255, 255, 0.09);
    --ink: #f5f3f7;
    --muted: #b3b0c0;
    --faint: #85828f;
    --f1red: #e10600;
    --f1red-ink: #ff5a52;
    --good: #00d26a;
    --bad: #ff4d56;
    font-family: "Titillium Web", system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--ink);
    min-height: 100vh;
    font-size: 16px;
    line-height: 1.45;
  }
  ::selection { background: var(--f1red); color: #fff; }
  :focus-visible { outline: 2px solid var(--f1red); outline-offset: 2px; border-radius: 2px; }

  /* Sticky slim header */
  .topbar {
    position: sticky; top: 0; z-index: 20;
    display: flex; flex-wrap: wrap; gap: 0.75rem 1rem;
    align-items: center; justify-content: space-between;
    padding: 0.7rem clamp(0.9rem, 4vw, 2.5rem);
    background: var(--bg);
    border-bottom: 2px solid var(--f1red);
  }
  .brand { display: flex; gap: 0.7rem; align-items: center; min-width: 0; }
  .speedmark { display: flex; gap: 3px; flex: none; }
  .speedmark i { width: 7px; height: 26px; background: var(--f1red); transform: skewX(-22deg); border-radius: 1px; }
  .speedmark i:nth-child(2) { opacity: 0.65; }
  .speedmark i:nth-child(3) { opacity: 0.35; }
  .brand h1 {
    font-size: 1.05rem; margin: 0; font-style: italic; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap;
  }
  .season { margin: 0; color: var(--faint); font-size: 0.72rem; }

  /* Segmented view toggle */
  .view-toggle {
    display: grid; grid-template-columns: 1fr 1fr;
    background: transparent; border: 1px solid var(--line);
    border-radius: 8px; padding: 3px; gap: 3px;
  }
  .view-toggle button {
    font: inherit; font-size: 0.82rem; font-weight: 700; font-style: italic;
    text-transform: uppercase; letter-spacing: 0.05em;
    background: transparent; color: var(--muted);
    border: 0; border-radius: 6px; padding: 0.55rem 1rem;
    min-height: 44px; cursor: pointer;
  }
  .view-toggle button[aria-selected="true"] { background: var(--f1red); color: #fff; }

  main {
    display: grid; gap: 1rem; align-items: start;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    max-width: 1200px; margin: 0 auto;
    padding: 1rem clamp(0.9rem, 4vw, 2.5rem) 2.5rem;
  }

  .standings-panel, .scenario-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem;
  }
  .panel-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .panel-head h2 {
    margin: 0; font-style: italic; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.03em; font-size: 1rem;
    border-left: 4px solid var(--f1red); padding-left: 0.55rem;
  }
  .updated, .pick-total { color: var(--faint); font-size: 0.75rem; white-space: nowrap; }
  .pick-total:not(:empty) { color: var(--f1red-ink); font-weight: 700; }
  .hint { margin: 0 0 0.9rem; color: var(--muted); font-size: 0.85rem; }
  .hint.small { font-size: 0.75rem; margin: 0.4rem 0 0.7rem; }

  /* Standings rows: flat, team-colour edge, tabular points */
  .standings { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .row {
    position: relative;
    display: grid; grid-template-columns: 1.7rem 40px minmax(0, 1fr) auto;
    gap: 0.65rem; align-items: center;
    padding: 0.5rem 0.5rem 0.5rem 0.75rem;
    border-radius: 8px;
  }
  .row::before {
    content: ""; position: absolute; left: 0; top: 8px; bottom: 8px;
    width: 3px; border-radius: 2px; background: var(--c, transparent);
  }
  .row[data-contender="true"] { background: rgba(225, 6, 0, 0.09); }
  .pos { font-weight: 700; font-style: italic; font-size: 1.05rem; text-align: center; font-variant-numeric: tabular-nums; }
  .photo {
    width: 40px; height: 40px; object-fit: cover; object-position: top;
    border-radius: 50%; background: var(--bg); border: 1px solid var(--line);
  }
  .photo.fallback {
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 700; font-style: italic; font-size: 0.72rem; color: var(--muted);
    border-color: var(--c);
  }
  .who { min-width: 0; display: flex; flex-direction: column; }
  .who strong { font-size: 0.95rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .who small { color: var(--faint); font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pts { text-align: right; font-variant-numeric: tabular-nums; }
  .pts strong { font-size: 1.15rem; font-style: italic; }
  .pts small { display: block; color: var(--faint); font-size: 0.7rem; white-space: nowrap; }

  select {
    font: inherit; font-size: 1rem; text-transform: none; letter-spacing: 0;
    background: var(--bg); color: var(--ink);
    border: 1px solid var(--line); border-radius: 8px;
    padding: 0.55rem 0.6rem; min-height: 44px; max-width: 100%;
  }

  /* Solver first: question form + visual answer */
  .solver { margin: 0; }
  .ask-row { display: grid; grid-template-columns: minmax(0, 1fr) 7rem; gap: 0.6rem; margin-bottom: 0.9rem; }
  .ask-field { display: grid; gap: 0.3rem; min-width: 0; }
  .ask-field label { color: var(--muted); text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.06em; font-weight: 700; }
  .answer {
    margin: 0; padding: 0.8rem; border-radius: 10px;
    border: 1px solid var(--line); border-left: 4px solid var(--f1red);
    background: var(--bg);
  }
  .answer[data-state="holds"] { border-left-color: var(--good); }
  .answer[data-state="impossible"] { border-left-color: var(--bad); }
  .stat-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; margin-bottom: 0.7rem; }
  .stat-row.slim { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stat-row.slim .stat b { font-size: 1.05rem; }
  .stat {
    background: var(--surface); border: 1px solid var(--line); border-radius: 8px;
    padding: 0.5rem 0.4rem; text-align: center;
  }
  .stat b { display: block; font-size: 1.25rem; font-style: italic; font-variant-numeric: tabular-nums; }
  .stat span { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--faint); font-weight: 700; }
  .bar {
    display: flex; height: 10px; border-radius: 6px; overflow: hidden;
    background: rgba(255, 255, 255, 0.08); margin-bottom: 0.4rem;
  }
  .bar i { display: block; height: 100%; }
  .bar .have { background: var(--muted); }
  .bar .need { background: var(--f1red); }
  .bar-cap { margin: 0 0 0.7rem; font-size: 0.78rem; color: var(--faint); }

  /* Scenario builder below the solver */
  .builder { margin-top: 1.1rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  .bulk-row { display: grid; grid-template-columns: minmax(0, 1fr) 7rem auto; gap: 0.6rem; align-items: end; }
  .apply {
