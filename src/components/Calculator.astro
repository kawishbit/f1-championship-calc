---
import snapshot from "../data/snapshot.json";

const updated = new Date(snapshot.generatedAt).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<div class="app" data-snapshot={JSON.stringify(snapshot)}>
  <header class="topbar">
    <div class="brand">
      <span class="speedmark" aria-hidden="true"><i></i><i></i><i></i></span>
      <div>
        <h1>Championship Calculator</h1>
        <p class="season">{snapshot.season} FIA Formula One World Championship&trade; fan calculator (unofficial)</p>
      </div>
    </div>
    <div class="view-toggle" role="tablist" aria-label="Standings view">
      <button type="button" data-view="drivers" role="tab" aria-selected="true">Drivers</button>
      <button type="button" data-view="teams" role="tab" aria-selected="false">Constructors</button>
    </div>
  </header>

  <main>
    <section class="standings-panel" aria-label="Standings">
      <div class="panel-head">
        <h2 id="standings-title">Driver standings</h2>
        <span class="updated">Updated {updated}</span>
      </div>
      <ol id="standings" class="standings"></ol>
    </section>

    <section class="scenario-panel" aria-label="Scenario builder">
      <div class="panel-head">
        <h2>What would it take</h2>
      </div>
      <p class="hint">Pick a contender and a target final position. The page shows the least-effort path: the cheapest finishes that reach it if every rival scores nothing more.</p>
      <div class="ask-row">
        <div class="ask-field">
          <label for="contender">Contender</label>
          <select id="contender"></select>
        </div>
        <div class="ask-field">
          <label for="target">Target</label>
          <select id="target"></select>
        </div>
      </div>
      <p id="answer" class="answer" aria-live="polite"></p>
      <div id="rounds" class="rounds"></div>
    </section>
  </main>

  <footer>
    <p>Unofficial fan project. Data: f1api.dev + OpenF1. Photos: F1 CDN via OpenF1.</p>
  </footer>
</div>

<script>
  import { leastEffortPath } from "../lib/championship.ts";

  const root = document.querySelector(".app");
  const data = JSON.parse(root.dataset.snapshot);

  const standingsEl = document.getElementById("standings");
  const standingsTitle = document.getElementById("standings-title");
  const contenderEl = document.getElementById("contender");
  const targetEl = document.getElementById("target");
  const answerEl = document.getElementById("answer");
  const roundsEl = document.getElementById("rounds");
  const viewButtons = [...document.querySelectorAll("[data-view]")];

  let view = "drivers";
  const overrides = new Set();
  const remaining = data.rounds.filter((r) => !r.played || overrides.has(r.raceId));

  const entries = () =>
    view === "drivers"
      ? data.drivers.map((d) => ({
          id: d.driverId, label: d.name, sub: d.teamName,
          colour: d.colour, photo: d.photo, code: d.code,
          points: d.points, wins: d.wins,
        }))
      : data.teams.map((t) => ({
          id: t.teamId, label: t.name, sub: null,
          colour: t.colour, photo: null, code: null,
          points: t.points, wins: t.wins,
        }));

  function renderContenders(list) {
    // Default to the standings leader (list is stored in rank order); keep the
    // visitor's choice afterwards.
    const keep = contenderEl.value || list[0]?.id;
    contenderEl.innerHTML = list
      .map((e) => `<option value="${e.id}"${e.id === keep ? " selected" : ""}>${e.label}</option>`)
      .join("");
    if (![...contenderEl.options].some((o) => o.value === keep)) contenderEl.selectedIndex = 0;
  }

  function renderTargets(list) {
    const keep = Number(targetEl.value) || 1;
    targetEl.innerHTML = list
      .map((_, i) => `<option value="${i + 1}"${i + 1 === keep ? " selected" : ""}>P${i + 1}</option>`)
      .join("");
  }

  function roundResult(assignment, round) {
    const prizes = [];
    if (assignment.racePosition) prizes.push(`P${assignment.racePosition}`);
    if (assignment.sprintPosition) prizes.push(`Sprint P${assignment.sprintPosition}`);
    if (prizes.length === 0) return null;
    return { title: round.name.replace(/ 2026$/, ""), prizes: prizes.join(" + ") };
  }

  function render() {
    const list = entries();
    renderContenders(list);
    renderTargets(list);
    const target = Number(targetEl.value) || 1;

    const base = list.map(({ id, points, wins }) => ({ id, points, wins }));
    const rounds = remaining.map((r) => ({ raceId: r.raceId, sprint: !!r.sprint }));
    const result = leastEffortPath(base, contenderEl.value, target, rounds);
    const me = list.find((x) => x.id === contenderEl.value);
    const final = me.points + result.pointsNeeded;

    standingsTitle.textContent = view === "drivers" ? "Driver standings" : "Constructor standings";
    standingsEl.innerHTML = "";
    const ordered = [...list].sort((a, b) => b.points - a.points || b.wins - a.wins);
    const leaderPts = Math.max(final, ordered[0].points);
    for (const e of ordered) {
      const pos = ordered.indexOf(e) + 1;
      const isMe = e.id === me.id;
      const pts = isMe ? final : e.points;
      const wins = isMe ? e.wins + result.winsAdded : e.wins;
      const li = document.createElement("li");
      li.className = "row";
      if (isMe) li.dataset.contender = "true";
      li.innerHTML = `
        <span class="pos" style="--c:${e.colour ?? "#666"}">${isMe ? `P${result.position}` : pos}</span>
        ${e.photo ? `<img class="photo" src="${e.photo}" alt="" loading="lazy" />` : `<span class="photo fallback" style="--c:${e.colour ?? "#666"}" aria-hidden="true">${(e.code ?? e.label).slice(0, 3)}</span>`}
        <span class="who"><strong>${e.label}</strong>${e.sub ? `<small>${e.sub}</small>` : ""}</span>
        <span class="pts"><strong>${pts}</strong><small>${isMe ? `goes P${result.position}` : pos === 1 ? "Leader" : `+${leaderPts - pts}`} · ${wins} win${wins === 1 ? "" : "s"}</small></span>`;
      standingsEl.append(li);
    }

    if (!result.possible) {
      answerEl.dataset.state = "impossible";
      answerEl.textContent = `${me.label} cannot reach P${target}: even winning everything lands P${result.position} on ${final} pts. Best reachable shown.`;
    } else if (result.pointsNeeded === 0) {
      answerEl.dataset.state = "holds";
      answerEl.textContent = `${me.label} already holds P${target} on ${me.points} pts — nothing more needed.`;
    } else {
      answerEl.dataset.state = "path";
      answerEl.textContent = `${me.label} needs ${result.pointsNeeded} more pts for P${target} (finishes on ${final} pts): ${result.assignments.flatMap((a) => {
        const r = remaining.find((x) => x.raceId === a.raceId);
        const hit = roundResult(a, r);
        return hit ? [`${hit.title}: ${hit.prizes}`] : [];
      }).join("; ")}. Rivals held on current points.`;
    }

    roundsEl.innerHTML = "";
    const byRound = new Map(result.assignments.map((a) => [a.raceId, a]));
    remaining.forEach((r, i) => {
      const a = byRound.get(r.raceId);
      const hit = a ? roundResult(a, r) : null;
      const details = document.createElement("details");
      details.className = "round";
      if (i === 0) details.open = true;
      details.innerHTML = `
        <summary>
          <span class="round-title">${r.name}</span>
          <span class="round-meta">R${r.round}${r.sprint ? " · Sprint" : ""}</span>
          <span class="count" data-empty="${!hit}">${hit ? hit.prizes : "No points needed"}</span>
        </summary>
        <p class="path-line">${hit ? `${me.label} finishes <strong>${hit.prizes}</strong> (${r.name}).` : `No points needed from ${me.label} here — rivals are assumed to score nothing more.`}</p>`;
      roundsEl.append(details);
    });
  }

  contenderEl.addEventListener("change", render);
  targetEl.addEventListener("change", render);
  for (const b of viewButtons) {
    b.addEventListener("click", () => {
      view = b.dataset.view;
      for (const x of viewButtons) x.setAttribute("aria-selected", String(x === b));
      render();
    });
  }

  render();
</script>

<style is:global>
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-400.woff2") format("woff2");
    font-weight: 400; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-600.woff2") format("woff2");
    font-weight: 600; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-700.woff2") format("woff2");
    font-weight: 700; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-600italic.woff2") format("woff2");
    font-weight: 600; font-style: italic; font-display: swap;
  }
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-700italic.woff2") format("woff2");
    font-weight: 700; font-style: italic; font-display: swap;
  }

  .app {
    --bg: #08080d;
    --surface: #0e0e15;
    --line: rgba(255, 255, 255, 0.09);
    --ink: #f5f3f7;
    --muted: #b3b0c0;
    --faint: #85828f;
    --f1red: #e10600;
    --f1red-ink: #ff5a52;
    --good: #00d26a;
    --bad: #ff4d56;
    font-family: "Titillium Web", system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--ink);
    min-height: 100vh;
    font-size: 16px;
    line-height: 1.45;
  }
  ::selection { background: var(--f1red); color: #fff; }
  :focus-visible { outline: 2px solid var(--f1red); outline-offset: 2px; border-radius: 2px; }

  /* Sticky slim header */
  .topbar {
    position: sticky; top: 0; z-index: 20;
    display: flex; flex-wrap: wrap; gap: 0.75rem 1rem;
    align-items: center; justify-content: space-between;
    padding: 0.7rem clamp(0.9rem, 4vw, 2.5rem);
    background: var(--bg);
    border-bottom: 2px solid var(--f1red);
  }
  .brand { display: flex; gap: 0.7rem; align-items: center; min-width: 0; }
  .speedmark { display: flex; gap: 3px; flex: none; }
  .speedmark i { width: 7px; height: 26px; background: var(--f1red); transform: skewX(-22deg); border-radius: 1px; }
  .speedmark i:nth-child(2) { opacity: 0.65; }
  .speedmark i:nth-child(3) { opacity: 0.35; }
  .brand h1 {
    font-size: 1.05rem; margin: 0; font-style: italic; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap;
  }
  .season { margin: 0; color: var(--faint); font-size: 0.72rem; }

  /* Segmented view toggle */
  .view-toggle {
    display: grid; grid-template-columns: 1fr 1fr;
    background: transparent; border: 1px solid var(--line);
    border-radius: 8px; padding: 3px; gap: 3px;
  }
  .view-toggle button {
    font: inherit; font-size: 0.82rem; font-weight: 700; font-style: italic;
    text-transform: uppercase; letter-spacing: 0.05em;
    background: transparent; color: var(--muted);
    border: 0; border-radius: 6px; padding: 0.55rem 1rem;
    min-height: 44px; cursor: pointer;
  }
  .view-toggle button[aria-selected="true"] { background: var(--f1red); color: #fff; }

  main {
    display: grid; gap: 1rem; align-items: start;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    max-width: 1200px; margin: 0 auto;
    padding: 1rem clamp(0.9rem, 4vw, 2.5rem) 2.5rem;
  }

  .standings-panel, .scenario-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem;
  }
  .panel-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .panel-head h2 {
    margin: 0; font-style: italic; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.03em; font-size: 1rem;
    border-left: 4px solid var(--f1red); padding-left: 0.55rem;
  }
  .updated { color: var(--faint); font-size: 0.75rem; white-space: nowrap; }
  .hint { margin: 0 0 0.9rem; color: var(--muted); font-size: 0.85rem; }

  /* Standings rows: flat, team-colour edge, tabular points */
  .standings { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .row {
    position: relative;
    display: grid; grid-template-columns: 1.7rem 40px minmax(0, 1fr) auto;
    gap: 0.65rem; align-items: center;
    padding: 0.5rem 0.5rem 0.5rem 0.75rem;
    border-radius: 8px;
  }
  .row::before {
    content: ""; position: absolute; left: 0; top: 8px; bottom: 8px;
    width: 3px; border-radius: 2px; background: var(--c, transparent);
  }
  .row[data-contender="true"] { background: rgba(225, 6, 0, 0.09); }
  .pos { font-weight: 700; font-style: italic; font-size: 1.05rem; text-align: center; font-variant-numeric: tabular-nums; }
  .photo {
    width: 40px; height: 40px; object-fit: cover; object-position: top;
    border-radius: 50%; background: var(--bg); border: 1px solid var(--line);
  }
  .photo.fallback {
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 700; font-style: italic; font-size: 0.72rem; color: var(--muted);
    border-color: var(--c);
  }
  .who { min-width: 0; display: flex; flex-direction: column; }
  .who strong { font-size: 0.95rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .who small { color: var(--faint); font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pts { text-align: right; font-variant-numeric: tabular-nums; }
  .pts strong { font-size: 1.15rem; font-style: italic; }
  .pts small { display: block; color: var(--faint); font-size: 0.7rem; white-space: nowrap; }

  /* Question form + answer */
  .ask-row { display: grid; grid-template-columns: 1fr auto; gap: 0.6rem; margin-bottom: 0.9rem; }
  .ask-field { display: grid; gap: 0.3rem; min-width: 0; }
  .ask-field label { color: var(--muted); text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.06em; font-weight: 700; }
  #target { min-width: 6rem; }
  select {
    font: inherit; font-size: 1rem;
    background: var(--bg); color: var(--ink);
    border: 1px solid var(--line); border-radius: 8px;
    padding: 0.55rem 0.6rem; min-height: 44px; max-width: 100%;
  }
  .answer {
    margin: 0 0 1rem; padding: 0.7rem 0.8rem; border-radius: 8px;
    font-size: 0.9rem; line-height: 1.5;
    border: 1px solid var(--line); border-left: 4px solid var(--f1red);
  }
  .answer[data-state="holds"] { border-left-color: var(--good); }
  .answer[data-state="impossible"] { border-left-color: var(--bad); }

  /* Round accordions */
  .rounds { display: grid; gap: 0.6rem; }
  .round { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: transparent; }
  .round[open] { border-color: rgba(255, 255, 255, 0.18); }
  .round summary {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto 1.2rem; gap: 0.6rem;
    align-items: center; min-height: 52px; padding: 0.65rem 0.8rem;
    cursor: pointer; list-style: none;
  }
  .round summary::-webkit-details-marker { display: none; }
  .round summary::after {
    content: ""; width: 0.55rem; height: 0.55rem;
    border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted);
    transform: rotate(45deg) translateY(-2px); justify-self: end;
  }
  .round[open] summary::after { transform: rotate(225deg) translateY(-2px); border-color: var(--f1red-ink); }
  .round-title { font-weight: 700; font-style: italic; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .round-meta { color: var(--faint); font-size: 0.72rem; white-space: nowrap; }
  .count {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--faint); white-space: nowrap;
  }
  .count[data-empty="false"] { color: var(--f1red-ink); }
  .path-line { margin: 0; padding: 0.2rem 0.8rem 0.8rem; font-size: 0.88rem; color: var(--muted); }
  .path-line strong { color: var(--ink); }

  footer { max-width: 1200px; margin: 0 auto; padding: 0 clamp(0.9rem, 4vw, 2.5rem) 3rem; }
  footer p { margin: 0; color: var(--faint); font-size: 0.75rem; }

  /* Desktop: sticky standings, roomier rows */
  @media (min-width: 901px) {
    .standings-panel { position: sticky; top: 76px; max-height: calc(100vh - 100px); overflow: auto; }
    .photo { width: 48px; height: 48px; }
    .row { grid-template-columns: 2rem 48px minmax(0, 1fr) auto; }
  }

  /* iPhone: full-width toggle, tighter panels */
  @media (max-width: 900px) {
    main { grid-template-columns: minmax(0, 1fr); }
    .view-toggle { order: 3; flex: 1 1 100%; }
    .brand h1 { font-size: 0.95rem; }
    .standings-panel, .scenario-panel { padding: 0.85rem; }
  }
  @media (max-width: 480px) {
    .ask-row { grid-template-columns: minmax(0, 1fr); }
    .round summary { grid-template-columns: minmax(0, 1fr) auto 1.2rem; align-items: start; padding-top: 0.8rem; padding-bottom: 0.8rem; }
    .round-title { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.3; }
    .round-meta { display: none; }
    .who small { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>
