---
import snapshot from "../data/snapshot.json";

const updated = new Date(snapshot.generatedAt).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<div class="app" data-snapshot={JSON.stringify(snapshot)}>
  <header class="topbar">
    <div class="brand">
      <span class="speedmark" aria-hidden="true"><i></i><i></i><i></i></span>
      <div>
        <h1>Championship Calculator</h1>
        <p class="season">{snapshot.season} FIA Formula One World Championship&trade; fan calculator (unofficial)</p>
      </div>
    </div>
    <div class="view-toggle" role="tablist" aria-label="Standings view">
      <button type="button" data-view="drivers" role="tab" aria-selected="true">Drivers</button>
      <button type="button" data-view="teams" role="tab" aria-selected="false">Constructors</button>
    </div>
  </header>

  <main>
    <section class="standings-panel" aria-label="Standings">
      <div class="panel-head">
        <h2 id="standings-title">Driver standings</h2>
        <span class="updated">Updated {updated}</span>
      </div>
      <ol id="standings" class="standings"></ol>
    </section>

     <section class="scenario-panel" aria-label="Scenario builder">
       <div class="avail">
         <div class="panel-head">
           <h2>Points still available</h2>
         </div>
         <div id="avail" class="stat-row quad"></div>
         <p class="hint small" id="avail-note"></p>
       </div>
       <div class="solver">
         <div class="panel-head">
           <h2>What would it take</h2>
         </div>
         <p class="hint">Shortest path for your contender if rivals scored nothing more — a best case, not a projection. For head-to-head finishes, use the scenario below.</p>
         <div class="ask-row">
           <div class="ask-field">
             <label for="contender">Contender</label>
             <select id="contender"></select>
           </div>
           <div class="ask-field">
             <label for="target">Target</label>
             <select id="target"></select>
           </div>
         </div>
         <div id="answer" class="answer" aria-live="polite"></div>
       </div>
       <div class="builder" id="builder">
         <div class="panel-head">
           <h2>Scenario</h2>
           <span id="pick-total" class="pick-total"></span>
         </div>
         <p class="impact" id="impact" aria-live="polite"></p>
         <div class="bulk-row">
           <div class="ask-field">
             <label for="bulk-driver">Driver</label>
             <select id="bulk-driver"></select>
           </div>
           <div class="ask-field">
             <label for="bulk-pos">Finish</label>
             <select id="bulk-pos"></select>
           </div>
           <button type="button" id="bulk-apply" class="apply">Set all</button>
         </div>
         <p class="hint small" id="scenario-note"></p>
         <details class="tune" id="tune">
           <summary><span class="tune-head"><span class="tune-title">Fine-tune each round</span><span class="tune-sub">Optional — tap a round to set its finishing order</span></span></summary>
           <div id="rounds" class="rounds"></div>
         </details>
         <button type="button" id="reset" class="reset">Reset scenario</button>
       </div>
     </section>
  </main>

  <footer>
    <p>Unofficial fan project. Data: f1api.dev + OpenF1 + Jolpica. Photos: F1 CDN via OpenF1.</p>
  </footer>
</div>

<script>
   import { projectStandings, leastEffortPath, availablePoints, insertPick } from "../lib/championship.ts";

   const root = document.querySelector(".app");
   const data = JSON.parse(root.dataset.snapshot);
   const POINTS = data.points ?? { race: [25, 18, 15, 12, 10, 8, 6, 4, 2, 1], sprint: [8, 7, 6, 5, 4, 3, 2, 1], fastestLap: 0 };
   const N_DRIVERS = data.drivers.length;
   const N_TEAMS = data.teams.length;

   const standingsEl = document.getElementById("standings");
   const standingsTitle = document.getElementById("standings-title");
   const contenderEl = document.getElementById("contender");
   const targetEl = document.getElementById("target");
   const answerEl = document.getElementById("answer");
   const roundsEl = document.getElementById("rounds");
   const resetBtn = document.getElementById("reset");
   const pickTotalEl = document.getElementById("pick-total");
   const bulkDriverEl = document.getElementById("bulk-driver");
   const bulkPosEl = document.getElementById("bulk-pos");
   const bulkApplyBtn = document.getElementById("bulk-apply");
   const availEl = document.getElementById("avail");
   const availNoteEl = document.getElementById("avail-note");
   const scenarioNoteEl = document.getElementById("scenario-note");
   const impactEl = document.getElementById("impact");
   const builderEl = document.getElementById("builder");
   const tuneEl = document.getElementById("tune");
   const viewButtons = [...document.querySelectorAll("[data-view]")];
   let view = "drivers";
   const scenario = {};
   const remaining = data.rounds.filter((r) => !r.played);
   const resetScenario = () => {
     for (const r of remaining) scenario[r.raceId] = { race: [], sprint: [], touched: false };
   };
   resetScenario();
  const entries = () =>
    view === "drivers"
      ? data.drivers.map((d) => ({
          id: d.driverId, label: d.name, sub: d.teamName,
          colour: d.colour, photo: d.photo, code: d.code,
          points: d.points, wins: d.wins,
        }))
      : data.teams.map((t) => ({
          id: t.teamId, label: t.name, sub: null,
          colour: t.colour, photo: null, code: null,
          points: t.points, wins: t.wins,
        }));

  function resultOptions(count, selected) {
    let html = `<option value="">—</option>`;
    for (let i = 1; i <= count; i++) html += `<option value="${i}"${selected === i ? " selected" : ""}>P${i}</option>`;
    return html;
  }

  function renderPeople(select, list, keep) {
    select.innerHTML = list
      .map((e) => `<option value="${e.id}"${e.id === keep ? " selected" : ""}>${e.label}</option>`)
      .join("");
    if (![...select.options].some((o) => o.value === keep)) select.selectedIndex = 0;
  }

  function renderContenders(list) {
    // Default to the standings leader (list is stored in rank order); keep the
    // visitor's choice afterwards.
    renderPeople(contenderEl, list, contenderEl.value || list[0]?.id);
  }

  function renderTargets(list) {
    const keep = Number(targetEl.value) || 1;
    targetEl.innerHTML = list
      .map((_, i) => `<option value="${i + 1}"${i + 1 === keep ? " selected" : ""}>P${i + 1}</option>`)
      .join("");
  }

  function renderBulk(list) {
    renderPeople(bulkDriverEl, list, bulkDriverEl.value || contenderEl.value || list[0]?.id);
    const keepPos = Number(bulkPosEl.value) || 1;
    let html = "";
    for (let i = 1; i <= list.length; i++) html += `<option value="${i}"${i === keepPos ? " selected" : ""}>P${i}</option>`;
    bulkPosEl.innerHTML = html;
  }

   function moveWithShift(picks, key, id, pos, max) {
     picks[key] = insertPick(picks[key], id, pos, max);
   }

   /** Ordered finishing-order list with drag + arrow-key reorder (listbox pattern). */
   function orderList({ picks, key, roundLabel, max, labelled }) {
     const table = key === "sprint" ? POINTS.sprint : POINTS.race;
     const list = document.createElement("ol");
     list.className = "order";
     list.setAttribute("role", "listbox");
     list.setAttribute("aria-label", `${roundLabel} ${key === "race" ? "finishing order" : "sprint order"}`);
     const placed = picks[key].filter(Boolean);
     const placedSet = new Set(placed);
     // Canonical order: previously set order first, then the rest of the field
     // up to max rows (race 22, sprint 8). Unset rounds read as the field in
     // standings order — dragging P2 to P1 then shifts everyone below down.
     const ordered = [];
     for (const id of picks[key]) {
       const e = labelled.find((x) => x.id === id);
       if (e && ordered.length < max) ordered.push(e);
     }
     for (const e of labelled) {
       if (ordered.length >= max) break;
       if (!placedSet.has(e.id)) ordered.push(e);
     }
     ordered.forEach((e, i) => {
       const seq = i + 1;
       const scored = picks[key].includes(e.id);
       const li = document.createElement("li");
       li.className = "order-row";
       li.draggable = true;
       li.dataset.id = e.id;
       li.setAttribute("role", "option");
       li.tabIndex = 0;
       li.setAttribute("aria-selected", String(scored));
       li.setAttribute("aria-posinset", String(seq));
       li.setAttribute("aria-setsize", String(max));
       li.title = `${e.label} — currently P${seq}. Drag or use arrow keys to reorder.`;
       li.innerHTML = `<span class="order-pos">P${seq}</span><span class="pick-name"><i style="--c:${e.colour ?? "#666"}"></i>${e.label}</span><span class="order-pts">+${table[seq - 1] ?? 0}</span><span class="order-move" aria-hidden="true"><i></i></span>`;
       li.addEventListener("dragstart", (ev) => {
         ev.dataTransfer.setData("text/plain", e.id);
         ev.dataTransfer.effectAllowed = "move";
         li.classList.add("dragging");
       });
       li.addEventListener("dragend", () => li.classList.remove("dragging"));
       li.addEventListener("dragover", (ev) => {
         ev.preventDefault();
         ev.dataTransfer.dropEffect = "move";
         li.classList.add("drop-target");
       });
       li.addEventListener("dragleave", () => li.classList.remove("drop-target"));
       li.addEventListener("drop", (ev) => {
         ev.preventDefault();
         const from = ev.dataTransfer.getData("text/plain");
         const ids = [...list.querySelectorAll(".order-row")].map((x) => x.dataset.id).filter((x) => x !== from);
         const to = [...list.querySelectorAll(".order-row")].map((x) => x.dataset.id).indexOf(li.dataset.id) + 1;
         ids.splice(to - 1, 0, from);
         // Full visible order, truncated: positions below the points still move.
         picks[key] = ids;
         picks.touched = true;
         afterPick(list, picks);
       });
       li.addEventListener("keydown", (ev) => {
         const rows = [...list.querySelectorAll(".order-row")].map((x) => x.dataset.id);
         const cur = rows.indexOf(e.id) + 1;
         const move = (to) => {
           const next = rows.filter((x) => x !== e.id);
           next.splice(to - 1, 0, e.id);
           picks[key] = next;
           picks.touched = true;
           afterPick(list, picks);
           list.closest("details.round")?.querySelector(`[data-id="${e.id}"]`)?.focus();
         };
         if (ev.key === "ArrowUp" && cur > 1) {
           ev.preventDefault();
           move(cur - 1);
         } else if (ev.key === "ArrowDown" && cur < max) {
           ev.preventDefault();
           move(cur + 1);
         } else if (ev.key === "Delete" || ev.key === "Backspace") {
           ev.preventDefault();
           moveWithShift(picks, key, e.id, null, max);
           afterPick(list, picks);
         }
       });
       list.append(li);
     });
     return list;
   }

   function afterPick(list, picks) {
     // Re-render this round's lists in place (details stay open), then project.
     const details = list.closest("details.round");
     const r = remaining.find((x) => x.raceId === details.dataset.race);
     const wrap = details.querySelector(".round-lists");
     wrap.innerHTML = "";
     wrap.append(orderList({ picks, key: "race", roundLabel: r.name, max: N_DRIVERS, labelled: entries() }));
     if (r.sprint) {
       const h = document.createElement("h4");
       h.className = "event-head";
       h.textContent = "Sprint";
       wrap.append(h);
       wrap.append(orderList({ picks, key: "sprint", roundLabel: r.name, max: POINTS.sprint.length, labelled: entries() }));
     }
     renderStandings();
     refreshCounts();
     renderImpact();
     flashStandings();
   }

   function buildRounds(list) {
     roundsEl.innerHTML = "";
     remaining.forEach((r, i) => {
       const picks = scenario[r.raceId];
       const details = document.createElement("details");
       details.className = "round";
       details.dataset.race = r.raceId;
       details.innerHTML = `
         <summary>
           <span class="round-title">${r.name}</span>
           <span class="round-meta">R${r.round}${r.sprint ? " · Sprint" : ""}</span>
           <span class="count" data-empty="true">No picks</span>
         </summary>
         <div class="round-lists"></div>`;
       const wrap = details.querySelector(".round-lists");
       wrap.append(orderList({ picks, key: "race", roundLabel: r.name, max: N_DRIVERS, labelled: list }));
       if (r.sprint) {
         const h = document.createElement("h4");
         h.className = "event-head";
         h.textContent = "Sprint";
         wrap.append(h);
         wrap.append(orderList({ picks, key: "sprint", roundLabel: r.name, max: POINTS.sprint.length, labelled: list }));
       }
       roundsEl.append(details);
     });
     refreshCounts();
   }

  function pickCount(picks) {
    return picks.race.filter(Boolean).length + picks.sprint.filter(Boolean).length;
  }
   function statCell(v, k, featured = false) {
     return `<div class="stat${featured ? " featured" : ""}"><b>${v}</b><span>${k}</span></div>`;
   }
   function renderAvail() {
     const cars = view === "teams" ? 2 : 1;
     const avail = availablePoints(remaining, POINTS, cars);
     availEl.innerHTML =
       statCell(avail.gp, "Grand Prix pts") +
       statCell(avail.sprint, "Sprint pts") +
       statCell(avail.fastestLap, "Fastest-lap pts") +
       statCell(avail.total, "Total pts", true);
     const sprints = remaining.filter((r) => r.sprint);
     const per = view === "teams" ? "P1+P2 per event" : "P1 per event";
     availNoteEl.textContent =
       sprints.length === 0
         ? `${remaining.length} Grands Prix left, no sprints (${per}).`
         : `${remaining.length} Grands Prix left, including a sprint at ${sprints.map((r) => r.name.replace(/ 2026$/, "")).join(", ")} (${per}).`;
   }

   function refreshCounts() {
     // A round counts as "set" once the visitor reorders it; untouched rounds
     // inherit the field order for honest shift-down display but count as empty.
     let total = 0;
     for (const details of roundsEl.querySelectorAll("details.round")) {
       const picks = scenario[details.dataset.race];
       const n = picks.touched ? pickCount(picks) : 0;
       total += n;
       const badge = details.querySelector(".count");
       badge.textContent = !picks.touched ? "Set finishing order" : `${n} pick${n === 1 ? "" : "s"}`;
       badge.dataset.empty = String(!picks.touched);
     }
     pickTotalEl.textContent = total === 0 ? "" : `${total} pick${total === 1 ? "" : "s"}`;
     scenarioNoteEl.textContent =
       total === 0
         ? "Nothing set yet — drag drivers into order or tap a round to open it. Sprints copy the race order when inside the top 8."
         : "Standings on the left already include these picks — red rows moved.";
   }

   function renderImpact() {
     const list = entries();
     const base = list.map(({ id, points, wins }) => ({ id, points, wins }));
     const projected = projectStandings(base, scenario, POINTS);
     const baseOrder = projectStandings(base, {}, POINTS).map((s) => s.id);
     const moved = projected.filter((s, i) => baseOrder.indexOf(s.id) !== i);
     const total = Object.values(scenario).reduce((n, p) => n + (p.touched ? pickCount(p) : 0), 0);
     if (total === 0) {
       impactEl.innerHTML = `<strong>No picks yet.</strong> Set a finish below — the <a href="#standings" data-scroll>standings on the left</a> update instantly.`;
     } else if (moved.length === 0) {
       impactEl.innerHTML = `<strong>${total} pick${total === 1 ? "" : "s"} in.</strong> No position changes yet — the <a href="#standings" data-scroll>standings on the left</a> already include them.`;
     } else {
       const names = moved.slice(0, 3).map((s) => {
         const e = list.find((x) => x.id === s.id);
         const pos = projected.indexOf(s) + 1;
         return `${e.label} → P${pos}`;
       }).join(" · ");
       impactEl.innerHTML = `<strong>${moved.length} mover${moved.length === 1 ? "" : "s"}: ${names}.</strong> See it in the <a href="#standings" data-scroll>standings on the left</a>.`;
     }
   }

   function renderStandings() {
     const list = entries();
     const base = list.map(({ id, points, wins }) => ({ id, points, wins }));
     const projected = projectStandings(base, scenario, POINTS);
     const baseOrder = projectStandings(base, {}, POINTS).map((s) => s.id);
     const leaderPts = projected[0]?.points ?? 0;

     standingsTitle.textContent = view === "drivers" ? "Driver standings" : "Constructor standings";
     standingsEl.innerHTML = "";
     for (const s of projected) {
       const e = list.find((x) => x.id === s.id);
       const pos = projected.indexOf(s) + 1;
       const isMe = e.id === contenderEl.value;
       const moved = baseOrder.indexOf(s.id) + 1 !== pos;
       const li = document.createElement("li");
       li.className = "row";
       if (isMe) li.dataset.contender = "true";
       if (moved) li.dataset.moved = "true";
       li.innerHTML = `
         <span class="pos" style="--c:${e.colour ?? "#666"}">${pos}</span>
         ${e.photo ? `<img class="photo" src="${e.photo}" alt="" loading="lazy" />` : `<span class="photo fallback" style="--c:${e.colour ?? "#666"}" aria-hidden="true">${(e.code ?? e.label).slice(0, 3)}</span>`}
         <span class="who"><strong>${e.label}</strong>${e.sub ? `<small>${e.sub}</small>` : ""}</span>
         <span class="pts"><strong>${s.points}</strong><small>${pos === 1 ? "Leader" : `+${leaderPts - s.points}`} · ${s.wins} win${s.wins === 1 ? "" : "s"}</small></span>`;
       standingsEl.append(li);
     }
   }

   function statRow(cells, slim = false) {
     return `<div class="stat-row${slim ? " slim" : ""}">${cells.map(([v, k]) => statCell(v, k)).join("")}</div>`;
   }

   function bar(havePct, needPct, label) {
     return `<div class="bar" role="img" aria-label="${label}"><i class="have" style="width:${havePct}%"></i>${needPct > 0 ? `<i class="need" style="width:${needPct}%"></i>` : ""}</div>`;
   }

   function renderSolver() {
     const list = entries();
     const me = list.find((x) => x.id === contenderEl.value) ?? list[0];
     const target = Number(targetEl.value) || 1;
     const base = list.map(({ id, points, wins }) => ({ id, points, wins }));
     const rounds = remaining.map((r) => ({ raceId: r.raceId, sprint: !!r.sprint }));
     const cars = view === "teams" ? 2 : 1;
     const result = leastEffortPath(base, me.id, target, rounds, POINTS, cars);
     const final = me.points + result.pointsNeeded;
     const totalAvail = availablePoints(rounds.map((r) => ({ raceId: r.raceId, sprint: r.sprint })), POINTS, cars).total;
     const ceiling = Math.max(me.points + totalAvail, final, 1);
     const havePct = Math.min(100, (me.points / ceiling) * 100);
     const needPct = Math.min(100 - havePct, (result.pointsNeeded / ceiling) * 100);
     if (!result.possible) {
       answerEl.dataset.state = "impossible";
       answerEl.innerHTML = `
         ${statRow([[`P${result.position}`, "Best reachable"], [final, "Max pts"], [`P${target}`, "Target"]])}
         ${bar(havePct, needPct, `${me.label} maxes out at ${final} points`)}
         <p class="bar-cap">${me.label} cannot reach P${target} even winning everything. ${view === "drivers" ? "Use the scenario below for head-to-head finishes." : ""}</p>`;
     } else if (result.pointsNeeded === 0) {
       answerEl.dataset.state = "holds";
       answerEl.innerHTML = `
         ${statRow([[`P${target}`, "Held"], [me.points, "Points"], ["+0", "Needed"]])}
         ${bar(havePct, 0, `${me.label} already holds P${target}`)}
         <p class="bar-cap">${me.label} already holds P${target} — nothing more needed.</p>`;
     } else {
       answerEl.dataset.state = "path";
       answerEl.innerHTML = `
         ${statRow([[`+${result.pointsNeeded}`, "Needed"], [final, "Finishes on"], [`P${target}`, "Target"]])}
         ${bar(havePct, needPct, `${me.label} needs ${result.pointsNeeded} more points`)}
         <p class="bar-cap">${result.winsAdded > 0 ? `Includes ${result.winsAdded} win${result.winsAdded === 1 ? "" : "s"}. ` : ""}Best case — rivals score nothing more.</p>`;
     }
   }

   function render() {
     const list = entries();
     renderContenders(list);
     renderTargets(list);
     renderBulk(list);
     renderAvail();
     builderEl.hidden = view !== "drivers";
     renderStandings();
     renderSolver();
     renderImpact();
   }
   let flashTimer = 0;
   function flashStandings() {
     const panel = document.querySelector(".standings-panel");
     panel.classList.remove("flash");
     void panel.offsetWidth;
     panel.classList.add("flash");
     window.clearTimeout(flashTimer);
     flashTimer = window.setTimeout(() => panel.classList.remove("flash"), 900);
   }
   contenderEl.addEventListener("change", render);
   targetEl.addEventListener("change", renderSolver);
   bulkApplyBtn.addEventListener("click", () => {
     const id = bulkDriverEl.value;
     const pos = Number(bulkPosEl.value) || 1;
     for (const r of remaining) {
       // Ordered insert over the current field: others shift down, tail drops.
       // Sprint copies the race order when the finish scores (top 8).
       const cur = scenario[r.raceId].race.length ? scenario[r.raceId].race : entries().map((e) => e.id);
       scenario[r.raceId].race = insertPick(cur, id, pos, N_DRIVERS);
       scenario[r.raceId].touched = true;
       if (r.sprint && pos <= 8) {
         const sCur = scenario[r.raceId].sprint.length ? scenario[r.raceId].sprint : scenario[r.raceId].race.slice();
         scenario[r.raceId].sprint = insertPick(sCur, id, pos, POINTS.sprint.length);
       }
     }
     buildRounds(entries());
     renderStandings();
     refreshCounts();
     renderImpact();
     flashStandings();
   });
   resetBtn.addEventListener("click", () => {
     resetScenario();
     buildRounds(entries());
     render();
   });
   document.addEventListener("click", (ev) => {
     const a = ev.target.closest?.('[data-scroll]');
     if (!a) return;
     ev.preventDefault();
     document.querySelector(".standings-panel")?.scrollIntoView({ behavior: "smooth", block: "nearest" });
     flashStandings();
   });
   for (const b of viewButtons) {
     b.addEventListener("click", () => {
       view = b.dataset.view;
       for (const x of viewButtons) x.setAttribute("aria-selected", String(x === b));
       resetScenario();
       buildRounds(entries());
       render();
     });
   }

   buildRounds(entries());
   render();
 </script>

 <style is:global>
   @font-face {
     font-family: "Titillium Web";
     src: url("/fonts/titillium-400.woff2") format("woff2");
     font-weight: 400; font-style: normal; font-display: swap;
   }
   @font-face {
     font-family: "Titillium Web";
     src: url("/fonts/titillium-600.woff2") format("woff2");
     font-weight: 600; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-700.woff2") format("woff2");
    font-weight: 700; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-600italic.woff2") format("woff2");
    font-weight: 600; font-style: italic; font-display: swap;
  }
  @font-face {
    font-family: "Titillium Web";
    src: url("/fonts/titillium-700italic.woff2") format("woff2");
    font-weight: 700; font-style: italic; font-display: swap;
  }

  .app {
    --bg: #08080d;
    --surface: #0e0e15;
    --line: rgba(255, 255, 255, 0.09);
    --ink: #f5f3f7;
    --muted: #b3b0c0;
    --faint: #85828f;
    --f1red: #e10600;
    --f1red-ink: #ff5a52;
    --good: #00d26a;
    --bad: #ff4d56;
